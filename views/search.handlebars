<nav>
  <a href="/">Home</a>&nbsp;|&nbsp;
  <a href="/search">Search</a>&nbsp;|&nbsp;
  <a href="/favorites">Favorites</a>&nbsp;|&nbsp;
  <a href="/reviews">Reviews</a>&nbsp;|&nbsp;
  <a href="/logout">Logout</a>
</nav>
<h1>Books Search</h1>
<form id="search-form">
  <label for="search-input">Enter a book title, keyword, or subject: </label>
  <input type="text" id="search-input" name="search-input" required value="{{search-input}}"
    placeholder="Search books..." />
  <button type="submit">Search</button>
</form>

<div>
  {{#if error}}
    <p style="color: red;">{{error}}</p>
  {{/if}}
</div>
<div>
  {{#if books}}
    <h2>Results for "{{query}}":</h2>
    <ul>
      {{#each books}}
        <li>
          <h3>{{title}}</h3>
          <p>Author(s):
            {{#if authors}}
              {{#each authors}}
                {{authors}}
              {{else}}Unknown
            {{/if}}
          </p>
          <p>{{description}}</p>
          <p><img src="{{thumbnail}}" alt="{{title}} Book cover" /></p>
          <p><a href="{{infoLink}}">Google Books Link</a></p>
          <form id="favorite-form">
            <input type="hidden" id="fav-book-id" value="{{id}}">
            <button type="submit">Add to Favorites</button>
          </form>
          <form id="review-form">
            <input type="hidden" id="rev-book-id" value="{{id}}">
            <textarea id="review-textarea" placeholder="Add a review..."></textarea>
            <button type="submit">Add Book Review</button>
          </form>
        </li>
      {{/each}}
  {{else}}
    <li>No books found</li>
    </ul>
  {{/if}}
</div>
<script src="js/search.js"></script>
<script src="js/favorite.js"></script>
<script src="js/review.js"></script>
